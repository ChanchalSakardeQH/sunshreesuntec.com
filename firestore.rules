rules_version = '2';

// Sunshree Suntec CHS – access rules
//   public/dues, public/site        anyone can read (the website); committee writes
//   admins/{uid}                    committee accounts (create by hand in the Firebase console)
//   users/{uid}                     member access requests: pending → approved / rejected
//   units/{unitId} (+ /ledger)      unit accounts: committee, or the approved member of that unit
//   bills/{id}, payments/{id}       bills and receipts: committee, or the approved member of that unit
//   liftExpenses/*                  lift AMC / repair expenses shared by units (committee only; shown on bills)
//   settings/*, counters/*          committee only
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function approvedFor(unitId) {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().status == 'approved'
        && profile().unit == unitId;
    }

    match /public/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'unit', 'mobile', 'email', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 120
        && request.resource.data.unit is string && request.resource.data.unit.size() <= 12
        && request.resource.data.mobile is string && request.resource.data.mobile.matches('^[6-9][0-9]{9}$')
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /units/{unitId} {
      allow read: if isAdmin() || approvedFor(unitId);
      allow write: if isAdmin();
      match /ledger/{entryId} {
        allow read: if isAdmin() || approvedFor(unitId);
        allow write: if isAdmin();
      }
    }

    match /bills/{billId} {
      allow read: if isAdmin() || approvedFor(resource.data.unitId);
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || approvedFor(resource.data.unitId);
      // Receipts are never deleted; a wrong one is marked cancelled.
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /liftExpenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /counters/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
