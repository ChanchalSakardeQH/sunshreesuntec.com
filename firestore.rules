rules_version = '2';

// Sunshree Suntec CHS – access rules (version 3.2)
//
//   public/dues, public/site        anyone can read (the website); dues amounts are masked here
//   private/dues                    real amounts: approved members and committee / staff
//   admins/{uid}                    committee members (no "kind") and staff (kind: 'staff', role, perms)
//   staffInvites/{email}            staff invited by the committee; claimed on first sign-in
//   staffRequests/{uid}             staff and officials asking for access from the registration form (3.6)
//   expenses/{id} (+ /log)          daily expenses with bill files kept in the Society's Drive (3.7)
//   staffSettlements/{id}           paybacks of expenses paid from own money, and advances to staff (3.7)
//   staffAgreements/{id}            permanent log of staff accepting the agreement
//   settings/staffAgreement         current agreement text and version
//   users/{uid}                     member access requests: pending → approved / rejected
//   units/{unitId} (+ /ledger)      unit accounts: staff with permission, or the approved member of that unit
//   bills, payments                 bills and receipts: as above; never deleted
//   liftExpenses, settings, counters
//
// Committee = an admins record without kind 'staff'. Staff act only within their perms and only after
// accepting the current agreement version.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function adminPath() { return /databases/$(database)/documents/admins/$(request.auth.uid); }
    function isTeam() { return signedIn() && exists(adminPath()); }
    function me() { return get(adminPath()).data; }
    // Active, and (auditors, officials) before the end date of their access if one is set.
    function active() {
      return me().get('active', true) == true
        && (me().get('validUntil', null) == null || request.time < me().get('validUntil', null));
    }
    function isCommittee() { return isTeam() && me().get('kind', 'committee') != 'staff' && active(); }
    function agreementOk() {
      return me().get('agreementVersion', 0)
        == get(/databases/$(database)/documents/settings/staffAgreement).data.version;
    }
    // Committee: everything. Staff: only the permissions given to them, after accepting the agreement.
    function perm(p) {
      return isCommittee()
        || (isTeam() && active() && me().get('kind', '') == 'staff'
            && me().get('perms', {}).get(p, false) == true
            && (me().get('agreementRequired', true) == false || agreementOk()));
    }
    function moneyPerm() {
      return perm('generateBills') || perm('recordPayments') || perm('cancelReceipts') || perm('corrections');
    }

    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    // Unit account (balance, bills, receipts, ledger): approved for that unit with full access.
    // Access 'basic' (e.g. a caretaker) sees only Society accounts and documents. Older records have no 'access': full.
    function approvedFor(unitId) {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().status == 'approved'
        && profile().get('access', 'full') == 'full'
        && profile().unit == unitId;
    }
    function fullAccess() { return profile().get('access', 'full') == 'full'; }
    // 3.13: an approved member of the unit with any access (full or basic), for the unit's documents.
    function approvedMember() {
      return signedIn() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().status == 'approved' && profile().get('removed', false) != true;
    }
    function memberOf(unitId) { return approvedMember() && profile().unit == unitId; }
    function memberAgreementVersion() { return get(/databases/$(database)/documents/settings/memberAgreement).data.version; }
    function changes() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Books closed up to this date (end of the last closed financial year); '' = nothing closed.
    function lockDate() {
      return exists(/databases/$(database)/documents/settings/billing)
        ? get(/databases/$(database)/documents/settings/billing).data.get('lockedUpTo', '') : '';
    }

    // Any approved member with a confirmed email (any unit).
    function approvedMember() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().status == 'approved';
    }

    // ---------- website ----------
    match /public/{docId} {
      allow read: if true;
      allow write: if isCommittee()
        || (docId == 'dues' && (moneyPerm() || perm('editUnits')))
        || (docId == 'site' && perm('website'));
    }

    // Real amounts: signed-in approved members and committee / staff with view access.
    match /private/{docId} {
      allow read: if perm('view') || (approvedMember() && fullAccess());
      allow write: if isCommittee() || (docId == 'dues' && (moneyPerm() || perm('editUnits')));
    }

    // ---------- committee and staff ----------
    match /admins/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isCommittee();
      // A staff member claims their invitation on first sign-in, with exactly the role and access invited.
      allow create: if isCommittee()
        || (signedIn() && request.auth.uid == uid
            && request.auth.token.email_verified == true
            && exists(/databases/$(database)/documents/staffInvites/$(request.auth.token.email))
            && request.resource.data.keys().hasOnly(['kind', 'role', 'perms', 'name', 'email', 'mobile', 'active', 'createdAt', 'invitedBy'])
            && request.resource.data.kind == 'staff'
            && request.resource.data.active == true
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.role == get(/databases/$(database)/documents/staffInvites/$(request.auth.token.email)).data.role
            && request.resource.data.perms == get(/databases/$(database)/documents/staffInvites/$(request.auth.token.email)).data.perms);
      // Staff may only record their own agreement acceptance and last sign-in.
      allow update: if isCommittee()
        || (signedIn() && request.auth.uid == uid
            && changes().hasOnly(['agreementVersion', 'agreementAcceptedAt', 'agreementName', 'lastLoginAt']));
      allow delete: if isCommittee();
    }

    // Staff and officials asking for access (registration form). The committee approves by creating admins/{uid}.
    match /staffRequests/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'role', 'org', 'mobile', 'email', 'status', 'createdAt', 'provider'])
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 120
        && request.resource.data.role in ['Society Manager', 'Accountant', 'Office Assistant', 'Housekeeping', 'Watchman / Security', 'Auditor', 'Government official (DDR / Registrar)', 'Other']
        && request.resource.data.org is string && request.resource.data.org.size() <= 160
        && request.resource.data.mobile is string && request.resource.data.mobile.matches('^[6-9][0-9]{9}$')
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow read: if (signedIn() && request.auth.uid == uid) || isCommittee();
      allow update, delete: if isCommittee();
    }

    match /staffInvites/{email} {
      allow read: if isCommittee() || (signedIn() && request.auth.token.email == email);
      allow write: if isCommittee();
    }

    match /staffAgreements/{id} {
      allow create: if signedIn() && isTeam()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.acceptedAt == request.time;
      allow read: if isCommittee() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if false;
    }

    // ---------- members ----------
    match /users/{uid} {
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'unit', 'mobile', 'email', 'status', 'createdAt', 'provider', 'relation'])
        && (!('relation' in request.resource.data) || request.resource.data.relation in ['owner', 'jointOwner', 'family', 'tenant', 'caretaker'])
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 120
        && request.resource.data.unit is string && request.resource.data.unit.size() <= 12
        && request.resource.data.mobile is string && request.resource.data.mobile.matches('^[6-9][0-9]{9}$')
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow read: if (signedIn() && request.auth.uid == uid) || perm('members') || perm('directory');
      allow update: if perm('members')
        // 3.13: the member records their acceptance of the current portal agreement (written in the same batch).
        || (signedIn() && request.auth.uid == uid && resource.data.status == 'approved'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['agreementVersion', 'agreementAcceptedAt', 'agreementId'])
            && request.resource.data.agreementVersion == memberAgreementVersion()
            && request.resource.data.agreementAcceptedAt == request.time
            && request.resource.data.agreementId == uid + '_v' + string(memberAgreementVersion())
            && existsAfter(/databases/$(database)/documents/memberAgreements/$(request.resource.data.agreementId)));
      allow delete: if isCommittee();
    }

    // 3.13: member portal agreement. Versions are permanent; each acceptance is a permanent record (id <uid>_v<version>).
    match /memberAgreementVersions/{v} {
      allow read: if signedIn();
      allow create: if isCommittee() && request.resource.data.version is int && v == string(request.resource.data.version)
        && request.resource.data.sections is list && request.resource.data.sections.size() > 0;
      allow update, delete: if false;
    }
    match /memberAgreements/{id} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || perm('members') || perm('view');
      allow create: if approvedMember()
        && id == request.auth.uid + '_v' + string(memberAgreementVersion())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.unit == profile().unit
        && request.resource.data.version == memberAgreementVersion()
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.signedName is string && request.resource.data.signedName.size() >= 3 && request.resource.data.signedName.size() <= 120
        && request.resource.data.confirmations is list && request.resource.data.confirmations.size() >= 3;
      // Only the details of the archived PDF and the email may be added later.
      allow update: if ((signedIn() && resource.data.uid == request.auth.uid) || perm('members'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pdf', 'emailed', 'emailedTo', 'cc', 'emailNote', 'archivedAt', 'resentAt', 'resentBy']);
      allow delete: if false;
    }

    // Decisions on member requests (approve, reject, remove, restore, edit): a permanent history.
    match /memberLog/{id} {
      allow read: if perm('members');
      allow create: if perm('members')
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.uid is string && request.resource.data.uid.size() <= 128
        && request.resource.data.action in ['approved', 'rejected', 'removed', 'restored', 'edited', 'notified'];
      allow delete: if isCommittee();   // only when deleting a test or mistaken record permanently
    }

    // Sign-in attempts, written by the sign-in screens (also before anyone is signed in, so failures are seen).
    // Only these fields, short texts, the server's time; a signed-in uid only for oneself. Passwords and tokens never.
    match /signInLog/{id} {
      function txt(f, n) { return request.resource.data[f] is string && request.resource.data[f].size() <= n; }
      allow read: if perm('members');
      allow delete: if isCommittee();
      allow create: if request.resource.data.keys().hasOnly(['at', 'method', 'where', 'page', 'result', 'code', 'detail', 'email', 'uid', 'appVersion', 'siteVersion', 'device', 'ms'])
        && request.resource.data.keys().hasAll(['at', 'method', 'where', 'page', 'result', 'code', 'detail', 'email', 'uid', 'appVersion', 'siteVersion', 'device', 'ms'])
        && request.resource.data.at == request.time
        && request.resource.data.method in ['google', 'password', 'register', 'reset']
        && request.resource.data.where in ['app', 'web']
        && request.resource.data.page in ['member', 'admin']
        && request.resource.data.result in ['ok', 'cancelled', 'failed']
        && txt('code', 80) && txt('detail', 500) && txt('email', 160) && txt('appVersion', 20) && txt('siteVersion', 20) && txt('device', 120)
        && request.resource.data.ms is int && request.resource.data.ms >= 0 && request.resource.data.ms < 3600000
        && (request.resource.data.uid == '' || (signedIn() && request.resource.data.uid == request.auth.uid));
    }

    // ---------- accounts ----------
    match /units/{unitId} {
      allow read: if perm('view') || approvedFor(unitId);
      allow create, delete: if isCommittee();
      // Money operations may change only the balance fields; unit editors only descriptive fields.
      // Rates, charge category, per-unit amounts, BPM and billing on/off stay with the committee.
      allow update: if isCommittee()
        || (moneyPerm() && changes().hasOnly(['balance', 'interestDue', 'lastBillId', 'unverified', 'updatedAt']))
        || (perm('editUnits') && changes().hasOnly(['name', 'type', 'status', 'carpetArea', 'areaSource', 'inlets',
                                                    'twoWheelers', 'fourWheelers', 'liftGroup', 'updatedAt']));
      match /ledger/{entryId} {
        allow read: if perm('view') || approvedFor(unitId);
        allow create: if moneyPerm() && request.resource.data.date > lockDate();
        allow update, delete: if false;   // ledger entries are permanent; mistakes are corrected by new entries
      }
      // Receipts kept by the past committee (2011–2016): read by the accounts team and the unit's approved member;
      // added or corrected by the committee or staff with the corrections permission; never deleted (mark as removed instead).
      match /pastReceipts/{rid} {
        allow read: if perm('view') || approvedFor(unitId);
        allow create, update: if perm('corrections');
        allow delete: if false;
      }
      // Tally ledger history up to the takeover date (read-only, loaded by the committee).
      match /history/{docId} {
        allow read: if perm('view') || approvedFor(unitId);
        allow write: if isCommittee();
      }
      // 3.13: documents uploaded by the unit's member (sale deeds and Index II, rental agreements, police verification,
      // occupants, past tenancies, other). The member edits or withdraws them until the committee acknowledges the
      // physical copy; the accounts team acknowledges or returns them.
      match /memberDocs/{docId} {
        allow read: if perm('view') || perm('unitRecords') || memberOf(unitId);
        allow create: if memberOf(unitId)
          && request.resource.data.keys().hasOnly(['kind', 'title', 'details', 'files', 'submittedBy', 'submittedByName', 'submittedAt', 'status', 'relation'])
          && request.resource.data.kind in ['ownership', 'rental', 'police', 'occupants', 'pastRental', 'other']
          && request.resource.data.submittedBy == request.auth.uid
          && request.resource.data.submittedAt == request.time
          && request.resource.data.status == 'submitted'
          && request.resource.data.files is list && request.resource.data.files.size() <= 20;
        allow update: if (memberOf(unitId) && resource.data.submittedBy == request.auth.uid && resource.data.status in ['submitted', 'returned']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'details', 'files', 'updatedAt', 'status'])
              && request.resource.data.status == 'submitted' && request.resource.data.files.size() <= 20)
          || (perm('unitRecords') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'ack', 'review', 'updatedAt', 'updatedBy'])
              && request.resource.data.status in ['submitted', 'acknowledged', 'returned']);
        allow delete: if (memberOf(unitId) && resource.data.submittedBy == request.auth.uid && resource.data.status in ['submitted', 'returned'])
          || isCommittee();
      }

      // Unit file: member register (I & J), tenants / rental history, communication,
      // electricity (MSEB) and property tax (PMC) records (3.12). Scans are in the Society's Google Drive.
      match /{record}/{recordId} {
        allow read: if record in ['members', 'tenants', 'comms', 'electricity', 'propertyTax'] && (perm('view') || approvedFor(unitId));
        allow create, update: if record in ['members', 'tenants', 'comms', 'electricity', 'propertyTax'] && perm('unitRecords');
        allow delete: if record in ['members', 'tenants', 'comms', 'electricity', 'propertyTax'] && isCommittee();
      }
    }

    match /bills/{billId} {
      allow read: if perm('view') || approvedFor(resource.data.unitId);
      allow create: if perm('generateBills') && request.resource.data.billDate > lockDate();
      allow update, delete: if false;     // a bill stays exactly as issued
    }

    match /payments/{paymentId} {
      allow read: if perm('view') || approvedFor(resource.data.unitId);
      allow create: if perm('recordPayments') && request.resource.data.date > lockDate();
      allow update: if perm('cancelReceipts')
        && changes().hasOnly(['status', 'cancelReason', 'cancelledAt', 'cancelledBy'])
        && request.resource.data.status == 'cancelled';
      allow delete: if false;             // receipts are never deleted
    }

    // When each unit file was last backed up to the Society's Google Drive (3.12).
    match /driveBackups/{unitId} {
      allow read: if perm('view') || perm('unitRecords');
      allow write: if perm('unitRecords');
    }

    // Duplicate receipts issued from the unit file (3.11): a permanent record of every copy printed.
    match /receiptCopies/{id} {
      allow read: if perm('view') || approvedFor(resource.data.unitId);
      allow create: if perm('recordPayments')
        && request.resource.data.issuedBy == request.auth.uid
        && request.resource.data.unitId is string
        && request.resource.data.receipts is list
        && request.resource.data.receipts.size() > 0 && request.resource.data.receipts.size() <= 60
        && request.resource.data.reason is string && request.resource.data.reason.size() > 0;
      allow update, delete: if false;
    }

    match /counters/{docId} {
      allow read, write: if perm('recordPayments')
        || (docId.matches('expenses-.*') && perm('approveExpenses'))
        || (docId.matches('(paybacks|advances)-.*') && perm('payExpenses'))
        || (docId.matches('acks-.*') && perm('unitRecords'));
    }

    // ---------- expenses (3.7) ----------
    function expenseTeam() { return perm('view') || perm('approveExpenses') || perm('payExpenses'); }
    function expenseOk(d) {
      return d.amount is number && d.amount > 0 && d.amount < 10000000
        && d.date is string && d.date.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && d.month == d.date[0:7]
        && d.paidBy in ['society', 'person', 'unpaid']
        && d.category is string && d.category.size() <= 80
        && d.payee is string && d.payee.size() <= 120
        && d.description is string && d.description.size() <= 500
        && d.files is list && d.files.size() <= 10;
    }
    match /expenses/{id} {
      allow read: if expenseTeam() || (signedIn() && resource.data.submittedBy == request.auth.uid);
      allow create: if (perm('submitExpenses') || perm('approveExpenses') || perm('payExpenses'))
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.submittedAt == request.time
        && expenseOk(request.resource.data)
        && !request.resource.data.keys().hasAny(['voucherNo', 'decidedBy', 'decidedAt', 'settlementId', 'settledOn', 'paidOn']);
      // The person who added it may correct it while it waits; approvers decide (never their own);
      // payers record payments and paybacks (not the decision).
      allow update: if expenseOk(request.resource.data) && (
        (signedIn() && resource.data.submittedBy == request.auth.uid && resource.data.status == 'submitted'
          && request.resource.data.status == 'submitted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'month', 'fy', 'amount', 'category', 'payee', 'billNo', 'description',
               'paidBy', 'paidByName', 'paidByUid', 'payMode', 'payRef', 'files', 'updatedAt']))
        || (perm('approveExpenses') && resource.data.submittedBy != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reason', 'decidedBy', 'decidedByName', 'decidedAt', 'voucherNo']))
        || (perm('payExpenses') && resource.data.status == 'approved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paidBy', 'payMode', 'payRef', 'paidOn', 'paidRecordedBy', 'paidRecordedAt', 'payFiles', 'settlementId', 'settledOn']))
        // an approved lift expense recovered from the members' bills (Lift sharing) is linked to it
        || (perm('liftExpenses') && resource.data.status == 'approved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['liftExpenseId', 'recovery'])));
      allow delete: if (signedIn() && resource.data.submittedBy == request.auth.uid && resource.data.status == 'submitted')
        || (isCommittee() && resource.data.status != 'approved');
      // Step-by-step history of the expense: added, corrected, approved, paid, paid back. Never changed.
      match /log/{logId} {
        allow read: if expenseTeam() || (signedIn() && get(/databases/$(database)/documents/expenses/$(id)).data.submittedBy == request.auth.uid);
        allow create: if signedIn() && isTeam()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time;
      }
    }
    match /staffSettlements/{id} {
      allow read: if expenseTeam() || (signedIn() && resource.data.personUid == request.auth.uid);
      allow create: if perm('payExpenses')
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.kind in ['payback', 'advance']
        && request.resource.data.amount is number && request.resource.data.amount >= 0
        && request.resource.data.expenseIds is list;
      allow delete: if isCommittee();
    }

    match /liftExpenses/{expenseId} {
      allow read: if perm('view');
      allow create, delete: if perm('liftExpenses');
      allow update: if isCommittee();
    }

    // Society documents (audit reports, AGM minutes …), stored in parts. Approved members and the
    // accounts team can read; only the committee adds or removes them.
    match /archiveDocs/{docId} {
      allow read: if perm('view') || approvedMember();
      allow write: if isCommittee();
      match /parts/{partId} {
        allow read: if perm('view') || approvedMember();
        allow write: if isCommittee();
      }
    }

    // Audited accounts by financial year (2011-12 onwards): balance sheet, income & expenditure,
    // year-end dues per unit, members, committee. Read by approved members and the accounts team.
    match /auditYears/{fy} {
      allow read: if perm('view') || approvedMember();
      allow write: if isCommittee();
    }

    // Permanent log of every change to the past committee's receipts (who, when, what, why).
    match /pastReceiptEdits/{id} {
      allow read: if perm('view');
      allow create: if perm('corrections') && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    // Read-only copy of the whole Tally books (groups, ledgers, vouchers) from the migration.
    match /tallyArchive/{docId} {
      allow read: if perm('view');
      allow write: if isCommittee();
    }

    // Frozen year-end statements (financial year closing).
    match /fyClosing/{fy} {
      allow read: if perm('view');
      allow write: if isCommittee();
    }

    match /settings/{docId} {
      allow read: if perm('view') || ((docId == 'staffAgreement' || docId == 'files') && isTeam())
        || (docId == 'memberAgreement' && signedIn())
        || (docId == 'files' && approvedMember());
      allow write: if isCommittee()
        || (docId == 'billing' && perm('generateBills') && changes().hasOnly(['lastRun', 'lastBilledMonth']));
    }
  }
}
